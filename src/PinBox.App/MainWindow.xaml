<Window
    x:Class="PinBox.App.MainWindow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PinBox.App.Converters"
    xmlns:models="using:PinBox.App.Models">

    <Grid
        x:Name="Shell"
        Background="{StaticResource PinBoxWarmBackgroundBrush}"
        Loaded="Shell_Loaded">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:ObjectNullToVisibilityConverter x:Key="ObjectNullToVisibilityConverter" />
            <converters:NoteColorBrushConverter x:Key="NoteColorBrushConverter" />
            <converters:NoteBorderBrushConverter x:Key="NoteBorderBrushConverter" />
            <converters:NoteTypeToVisibilityConverter x:Key="NoteTypeToVisibilityConverter" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="28,22,28,16"
            Background="{StaticResource PinBoxWarmBackgroundBrush}">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3">
                    <TextBlock
                        FontSize="32"
                        FontWeight="SemiBold"
                        Text="PinBox" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{StaticResource PinBoxMutedInkBrush}"
                        Text="Little boxes for quick notes, tiny lists, and useful things you want nearby." />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <Button
                        Command="{Binding CreatePlainNoteCommand}"
                        Content="+ Note"
                        Style="{StaticResource PrimaryButtonStyle}" />
                    <Button
                        Command="{Binding CreateChecklistNoteCommand}"
                        Content="+ Checklist" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Padding="28,0,28,28"
            ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*" MinWidth="600" />
                <ColumnDefinition Width="0.95*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="18"
                Background="{StaticResource PinBoxSurfaceBrush}"
                BorderBrush="{StaticResource PinBoxBorderBrush}"
                BorderThickness="1"
                CornerRadius="24">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            PlaceholderText="Search title, content, or checklist items"
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox
                            Grid.Column="1"
                            Width="150"
                            DisplayMemberPath="Label"
                            ItemsSource="{Binding TypeFilters}"
                            SelectedItem="{Binding SelectedTypeFilter, Mode=TwoWay}" />

                        <CheckBox
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="Pinned"
                            Foreground="{StaticResource PinBoxInkBrush}"
                            IsChecked="{Binding ShowPinnedOnly, Mode=TwoWay}" />

                        <CheckBox
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Content="Archived"
                            Foreground="{StaticResource PinBoxInkBrush}"
                            IsChecked="{Binding ShowArchived, Mode=TwoWay}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <GridView
                            x:Name="NotesGrid"
                            IsItemClickEnabled="True"
                            ItemsSource="{Binding FilteredNotes}"
                            SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                            SelectionMode="Single">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="0,0,14,14" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinWidth" Value="270" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:PinNote">
                                    <Border
                                        Width="270"
                                        MinHeight="190"
                                        Padding="16"
                                        Background="{Binding ColorVariant, Converter={StaticResource NoteColorBrushConverter}}"
                                        BorderBrush="{Binding ColorVariant, Converter={StaticResource NoteBorderBrushConverter}}"
                                        BorderThickness="1.25"
                                        CornerRadius="20">
                                        <Grid RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock
                                                        FontSize="17"
                                                        FontWeight="SemiBold"
                                                        MaxLines="2"
                                                        Text="{Binding DisplayTitle}" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{StaticResource PinBoxMutedInkBrush}"
                                                        Text="{Binding CardSubtitle}" />
                                                </StackPanel>
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="8,3"
                                                    Background="#66FFFFFF"
                                                    CornerRadius="10"
                                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Text="Pinned" />
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Spacing="8">
                                                <TextBlock
                                                    FontSize="13"
                                                    Foreground="{StaticResource PinBoxMutedInkBrush}"
                                                    MaxLines="5"
                                                    Text="{Binding Preview}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource PinBoxMutedInkBrush}"
                                                    Text="{Binding ChecklistSummary}"
                                                    Visibility="{Binding Type, Converter={StaticResource NoteTypeToVisibilityConverter}, ConverterParameter=Checklist}" />
                                            </StackPanel>

                                            <Grid Grid.Row="2" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{StaticResource PinBoxMutedInkBrush}"
                                                    Text="{Binding UpdatedDescription}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Click="CardPinButton_Click"
                                                    Content="{Binding PinActionText}"
                                                    Style="{StaticResource TinyButtonStyle}"
                                                    Tag="{Binding}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Click="CardArchiveButton_Click"
                                                    Content="{Binding ArchiveActionText}"
                                                    Style="{StaticResource TinyButtonStyle}"
                                                    Tag="{Binding}" />
                                                <Button
                                                    Grid.Column="3"
                                                    Click="CardDeleteButton_Click"
                                                    Content="Delete"
                                                    Style="{StaticResource TinyButtonStyle}"
                                                    Tag="{Binding}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <Border
                            Padding="36"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#AAFFFDF8"
                            BorderBrush="{StaticResource PinBoxBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="24"
                            Visibility="{Binding HasFilteredNotes, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel
                                Width="360"
                                HorizontalAlignment="Center"
                                Spacing="12">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="28"
                                    Text="📌" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding EmptyStateTitle}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource PinBoxMutedInkBrush}"
                                    Text="{Binding EmptyStateBody}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Button
                                        Command="{Binding CreatePlainNoteCommand}"
                                        Content="Create note"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button
                                        Command="{Binding CreateChecklistNoteCommand}"
                                        Content="Create checklist" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="20"
                Background="{StaticResource PinBoxSurfaceBrush}"
                BorderBrush="{StaticResource PinBoxBorderBrush}"
                BorderThickness="1"
                CornerRadius="24">
                <Grid>
                    <StackPanel
                        Spacing="16"
                        Visibility="{Binding SelectedNote, Converter={StaticResource ObjectNullToVisibilityConverter}}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Text="Edit box" />
                                <TextBlock
                                    Foreground="{StaticResource PinBoxMutedInkBrush}"
                                    Text="{Binding SelectedNote.CardSubtitle}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Command="{Binding ToggleSelectedPinCommand}"
                                Content="{Binding SelectedNote.PinActionText}" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding ArchiveSelectedCommand}"
                                Content="{Binding SelectedNote.ArchiveActionText}" />
                        </Grid>

                        <TextBox
                            Header="Title"
                            PlaceholderText="Give this little box a name"
                            Text="{Binding SelectedNote.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PinBoxMutedInkBrush}"
                                Text="Color" />
                            <Grid RowSpacing="8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    Background="{StaticResource PinBoxPeachBrush}"
                                    BorderBrush="{StaticResource PinBoxPeachBorderBrush}"
                                    Click="ColorButton_Click"
                                    Content="Peach"
                                    Tag="Peach" />
                                <Button
                                    Grid.Column="1"
                                    Background="{StaticResource PinBoxSageBrush}"
                                    BorderBrush="{StaticResource PinBoxSageBorderBrush}"
                                    Click="ColorButton_Click"
                                    Content="Sage"
                                    Tag="Sage" />
                                <Button
                                    Grid.Column="2"
                                    Background="{StaticResource PinBoxBlueBrush}"
                                    BorderBrush="{StaticResource PinBoxBlueBorderBrush}"
                                    Click="ColorButton_Click"
                                    Content="Blue"
                                    Tag="Blue" />
                                <Button
                                    Grid.Row="1"
                                    Background="{StaticResource PinBoxSandBrush}"
                                    BorderBrush="{StaticResource PinBoxSandBorderBrush}"
                                    Click="ColorButton_Click"
                                    Content="Sand"
                                    Tag="Sand" />
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Background="{StaticResource PinBoxLavenderBrush}"
                                    BorderBrush="{StaticResource PinBoxLavenderBorderBrush}"
                                    Click="ColorButton_Click"
                                    Content="Lavender"
                                    Tag="Lavender" />
                            </Grid>
                        </StackPanel>

                        <TextBox
                            AcceptsReturn="True"
                            Header="Note"
                            Height="190"
                            PlaceholderText="Write something quick and useful..."
                            Text="{Binding SelectedNote.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            Visibility="{Binding SelectedNote.Type, Converter={StaticResource NoteTypeToVisibilityConverter}, ConverterParameter=PlainText}" />

                        <StackPanel
                            Spacing="10"
                            Visibility="{Binding SelectedNote.Type, Converter={StaticResource NoteTypeToVisibilityConverter}, ConverterParameter=Checklist}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PinBoxMutedInkBrush}"
                                    Text="Checklist items" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding AddChecklistItemCommand}"
                                    Content="+ Item" />
                            </Grid>

                            <ScrollViewer MaxHeight="260">
                                <ItemsRepeater ItemsSource="{Binding SelectedNote.ChecklistItems}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChecklistItem">
                                            <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsCompleted, Mode=TwoWay}" />
                                                <TextBox
                                                    Grid.Column="1"
                                                    PlaceholderText="Checklist item"
                                                    Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Click="RemoveChecklistItem_Click"
                                                    Content="×"
                                                    Style="{StaticResource TinyButtonStyle}"
                                                    Tag="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{StaticResource PinBoxMutedInkBrush}"
                                Text="{Binding SaveStatus}" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding DeleteSelectedCommand}"
                                Content="Delete box" />
                        </Grid>
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{Binding SelectedNote, Converter={StaticResource ObjectNullToVisibilityConverter}, ConverterParameter=Invert}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="30"
                            Text="🗂️" />
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="Pick a box to edit" />
                        <TextBlock
                            Width="260"
                            Foreground="{StaticResource PinBoxMutedInkBrush}"
                            Text="Create or select a note from the board. Editing stays simple: title, text or checklist, pin, archive, color."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
